# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Supabase Client Configuration (isi dengan URL & Anon Key proyek Supabase Anda)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Optional: URL gambar QRIS asli toko Do-Siti
VITE_QRIS_IMAGE_URL=""

# Server session secret for local Express API mode
SESSION_SECRET=""
